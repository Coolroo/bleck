# Everything the toolkit generates or is handed: discs, extracts, staging,
# built images, symbol lists, loader codelists. Large, and mostly not ours to
# distribute. Grouped under one directory so the repository root stays readable.
work/

# Mod overlays contain extracted game assets — manifests are committed,
# contents are not. Remove this line for a mod of wholly original work.
mods/*/overlay/

# Built disc images. `bleck mod build` writes wherever it is told, and the docs
# use `out.wbfs` in the repo root — a 424 MB accidental commit is easy to make
# and unpleasant to undo.
*.iso
*.rvz
*.wbfs

# Mintlify
docs-site/node_modules/
docs-site/.mint/

# Python
# Note: uv.lock IS committed — reproducible installs are the point.
.uv-cache/
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
build/
dist/
# ⚠️ `build/` above also matches the `bleck/mods/build/` package, so a new module
# added there is silently untracked — `__init__.py` was lost that way and is
# still missing from git. These negations stop the next one going the same way.
!bleck/mods/build/
!bleck/mods/build/*.py

# Machine-local tool paths
.env
