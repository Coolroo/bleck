-- The two-line test D71 says should have come first.
--
-- gw[30] is written either side of the map change. Three outcomes, and they
-- mean completely different things:
--
--   1 then the map changes  -- it works; the bug is not reproduced here
--   1 then 2, no map change -- the call ran and did nothing
--   1 and stays 1           -- the script DIED at the call
--
-- Only the third would mean the thing being chased since D70 is the wrong
-- problem entirely.
--
-- `main` free-runs at gameplay, so this needs no button press: the combo below
-- exists only to pull the combo block into the module, which is what D70
-- isolated as the trigger.

script main {
    -- Same 120-frame settle the generated boot script uses. Without it the
    -- first run hung in MAPCHANGE stage 11 forever, which is D51's shape and
    -- nothing to do with what is being measured.
    wait(120)
    gw[30] = 1
    evt_seq_mapchange("he1_01", 0)
    gw[30] = 2
}

script unused {
    gw[29] = 1
}
