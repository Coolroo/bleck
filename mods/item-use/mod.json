{
  "schema": 1,
  "name": "item-use",
  "version": "0.2.0",
  "description": "Does a patched item use script actually ENTER when the player uses the item?",
  "base": "eu0",
  "code": {
    "sources": ["src"],
    "target": "eu0",
    "module_id": 2,
    "banner": false,
    "patches": [
      { "script": "item:0x41", "at": 0, "expect": "USER_FUNC 4", "call": "on_item_41" },
      { "script": "item:0x42", "at": 0, "expect": "USER_FUNC 4", "call": "on_item_42" },
      { "script": "item:0x43", "at": 0, "expect": "USER_FUNC 4", "call": "on_item_43" },
      { "script": "item:0x44", "at": 0, "expect": "USER_FUNC 4", "call": "on_item_44" },
      { "script": "item:0x45", "at": 0, "expect": "USER_FUNC 4", "call": "on_item_45" },
      { "script": "item:0x46", "at": 0, "expect": "USER_FUNC 4", "call": "on_item_46" },
      { "script": "item:0x47", "at": 0, "expect": "USER_FUNC 4", "call": "on_item_47" },
      { "script": "item:0x48", "at": 0, "expect": "USER_FUNC 4", "call": "on_item_48" }
    ]
  }
}
