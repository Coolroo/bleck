{
  "schema": 1,
  "name": "item-patch",
  "version": "0.1.0",
  "description": "D92: patch an item use script through code.patches, with an argc-4 replacement",
  "base": "eu0",
  "code": {
    "sources": ["src"],
    "target": "eu0",
    "module_id": 2,
    "patches": [
      {
        "script": "item:0x41",
        "at": 0,
        "expect": "USER_FUNC 4",
        "call": "on_item_use"
      }
    ]
  }
}
