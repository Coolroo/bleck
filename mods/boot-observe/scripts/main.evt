-- Deliberately NOT called `main`: bleck auto-starts a script by that name, and
-- the whole point here is that our own C decides when it starts, exactly as the
-- generated boot watcher does.

script booter {
    gw[28] = 1
    wait(120)
    gw[28] = 2
    evt_seq_mapchange("mac_01", 0)
    gw[28] = 3
}

script unused {
    gw[29] = 1
}
