{
  "schema": 1,
  "name": "door-attended",
  "version": "0.1.0",
  "description": "Does a door patch ENTER when the player uses the door? The last selector never observed running.",
  "base": "eu0",
  "code": {
    "sources": ["src"],
    "target": "eu0",
    "module_id": 2,
    "banner": false,
    "patches": [
      { "script": "door:he1_01:0:interact", "at": 0, "expect": "MULF",  "call": "on_door_interact" },
      { "script": "door:he1_01:0:init",     "at": 0, "expect": "0x0002001A", "call": "on_door_init" },
      { "script": "door:he1_01:0:move",     "at": 0, "expect": "MULF",  "call": "on_door_move" },
      { "script": "door:he1_01:9:interact", "at": 0, "expect": "MULF",  "call": "on_door_interact" }
    ]
  }
}
